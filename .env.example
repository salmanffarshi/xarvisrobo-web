# Xarvisrobo — environment variable template.
# Copy this file to `.env` (or `.env.local`) and fill in real values there.
# NEVER commit the filled-in file — real secrets stay local (see .gitignore).
# Keys are added phase by phase; values are intentionally empty here.

# PostgreSQL connection string — Neon POOLED URL at runtime (host has `-pooler`).
# Neon, ap-southeast-1 Singapore. Phase A.2.
DATABASE_URL=

# Neon DIRECT (non-pooled) URL — used by `prisma migrate` only. Required wherever
# migrations run (prod + local). Locally = the dev DB's direct URL. Phase J.2.
DIRECT_URL=

# Auth.js (NextAuth v5) session-signing secret. Generate: openssl rand -base64 32.
# Use a FRESH secret in production — never reuse the dev value. Phase A.2/A.4.
AUTH_SECRET=

# Base URL of the app, used by Auth.js callbacks (dev: http://localhost:3000;
# prod: https://your-domain). Phase A.4.
NEXTAUTH_URL=

# Set to `true` in production (Vercel) so Auth.js trusts the deployment host
# behind the proxy. Leave unset locally. Phase J.2.
AUTH_TRUST_HOST=

# Absolute base URL used in email + notification links (falls back to
# NEXTAUTH_URL, then localhost). Set to the prod domain in production. Phase G/I.
APP_URL=

# Cloudinary — image storage (product images, payment screenshots). Later phase.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email. Later phase.
RESEND_API_KEY=
# From address on your verified Resend sending domain, so email delivers to any
# recipient (not just the account owner). Format: "Name <local@your-domain>".
# Leave unset in early dev to fall back to Resend's shared onboarding@resend.dev
# (owner-only delivery). Phase I / Issue 2.
RESEND_FROM=

# Telegram — admin alerts (new order, payment proof submitted). If either is
# unset the app no-ops the alert (never throws). Phase I.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
