// ============================================================================
// XARVISROBO - PRISMA SCHEMA
// ============================================================================
// Production data model for the Xarvisrobo e-commerce + manufacturing system.
//
// Design principles:
//   1. Historical orders never mutate (JSON snapshots for product & address)
//   2. Customer-facing order status is separate from internal manufacturing
//   3. Role-based access from day 1 (future roles pre-defined)
//   4. Every mutation has an audit trail (OrderStatusHistory)
//   5. Reusable by future mobile app via /api/v1/*
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  ENGINEER
  QC
  SUPPORT
}

enum PaymentMethod {
  BKASH
  NAGAD
  COD
}

enum PaymentStatus {
  PENDING // waiting on admin
  VERIFIED // admin confirmed payment received
  REJECTED // admin rejected (wrong txn, amount mismatch, etc.)
  INFO_REQUESTED // admin needs more info from customer
}

// Customer-facing statuses only. Internal manufacturing stages live on the
// Manufacturing model and are never exposed to customers.
enum OrderStatus {
  // Prepaid path (bKash/Nagad/Bank)
  WAITING_FOR_PAYMENT // prepaid orders start here
  WAITING_FOR_PAYMENT_VERIFICATION // customer submitted payment proof (Phase D)
  PAYMENT_VERIFIED // admin approved payment (Phase E) → manufacturing created
  // COD path
  WAITING_FOR_ORDER_CONFIRMATION // COD orders start here; rep phones to confirm
  ORDER_CONFIRMED // COD confirmed by phone (Phase E) → manufacturing created
  // Shared tail
  IN_PRODUCTION // admin started production (Phase E)
  SHIPPED // handed to courier
  DELIVERED // customer received
  RETURNED // returned after ship/deliver; reverses revenue, record kept (Phase F)
  CANCELLED // terminal, reason stored
}

// Explicit customer choice at checkout — NOT derived from the address district
// (ADR-016). Stored on every order for records + future courier planning.
enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum ManufacturingStatus {
  WAITING_FOR_PRODUCTION
  COMPONENTS_COLLECTED
  ASSEMBLY
  FIRMWARE_INSTALLED
  TESTING
  QC
  PACKAGING
  READY_TO_SHIP
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ProductImage now holds media of both kinds (Phase H #7); the model keeps its
// name to avoid churn. Existing rows default to IMAGE.
enum ProductMediaType {
  IMAGE
  VIDEO
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  addresses             Address[]
  cart                  Cart?
  orders                Order[]              @relation("CustomerOrders")
  verifiedPayments      Payment[]            @relation("VerifiedByAdmin")
  statusChanges         OrderStatusHistory[] @relation("ChangedByUser")
  authoredNotes         CustomerNote[]       @relation("NoteAuthor")
  notesAboutMe          CustomerNote[]       @relation("NoteSubject")
  assignedManufacturing Manufacturing[]      @relation("AssignedEngineer")
  notifications         Notification[]
  sessions              Session[]
  accounts              Account[]
  passwordResetTokens   PasswordResetToken[]

  @@index([role])
  @@index([email])
}

// ---- Auth.js (NextAuth v5) required models ----------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(plaintext); the plaintext lives only in the emailed link
  expiresAt DateTime // createdAt + 24h
  usedAt    DateTime? // null until redeemed — single-use
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// ADDRESS
// ============================================================================

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String // "Home", "Office", etc.
  recipientName String
  phone         String
  streetAddress String
  city          String
  district      String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?
  description      String   @db.Text
  categoryId       String
  basePrice        Decimal  @db.Decimal(10, 2)
  stockQuantity    Int      @default(0)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  // Flexible schema for varying robot specs (voice model, screen, sensors, etc.)
  specifications   Json?
  // Ordered array of { title, description } feature highlights (Phase H #6),
  // same ordered-array-in-Json pattern as specifications.
  features         Json?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  type      ProductMediaType @default(IMAGE)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================================
// CART
// ============================================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int
  // Add-time price, informational only — cart math always uses the live
  // Product.basePrice (ADR-015); authoritative pricing happens at order time
  priceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
}

// ============================================================================
// ORDER
// ============================================================================

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique // Human-readable: XR-2026-0001
  userId         String
  status         OrderStatus // always set explicitly at placement (ADR-016)
  paymentMethod  PaymentMethod
  deliveryZone   DeliveryZone // explicit customer radio at checkout (ADR-016)
  subtotal       Decimal       @db.Decimal(10, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(10, 2) // COD: ৳60 inside / ৳130 outside; prepaid: 0
  // Coupon snapshot (Phase E.5). Set at placement if a valid coupon was applied;
  // frozen thereafter so editing/deleting the coupon never mutates a past order.
  couponCode     String? // normalized (UPPERCASE) code used at placement
  couponId       String? // the Coupon.id redeemed (snapshot, not a live FK)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2) // subtotal-only discount; 0 if no coupon
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("BDT")
  // Set once at placement to dedupe double-submits.
  idempotencyKey String?       @unique

  // JSON snapshot of the shipping address so historical orders don't change
  // if the user later edits or deletes their Address record.
  // Shape: { recipientName, phone, streetAddress, city, district, postalCode }
  shippingAddress Json

  contactPhone  String
  deliveryNotes String?

  cancelledAt  DateTime?
  cancelReason String?
  returnedAt   DateTime? // set when marked RETURNED (Phase F)
  returnReason String? // why the order was returned (Phase F)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User                 @relation("CustomerOrders", fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  manufacturing Manufacturing?
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  // JSON snapshot: { name, sku, specifications } at purchase time.
  // Product records may change, but historical order lines must not.
  productSnapshot Json
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  lineTotal       Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// Full audit trail for order status changes. Every status change goes here.
model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String
  note        String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation("ChangedByUser", fields: [changedById], references: [id])

  @@index([orderId])
}

// ============================================================================
// PAYMENT
// ============================================================================

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  // The next 4 are null for COD, required for bKash/Nagad/Bank.
  transactionId   String?
  senderNumber    String?
  paidAmount      Decimal?      @db.Decimal(10, 2)
  screenshotUrl   String?
  status          PaymentStatus @default(PENDING)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  adminNotes      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VerifiedByAdmin", fields: [verifiedById], references: [id])

  @@index([status])
  @@index([orderId])
}

// ============================================================================
// MANUFACTURING (internal only, never exposed to customers)
// ============================================================================

model Manufacturing {
  id             String              @id @default(cuid())
  orderId        String              @unique
  internalStatus ManufacturingStatus @default(WAITING_FOR_PRODUCTION)
  assignedToId   String? // typically an ENGINEER role
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedEngineer", fields: [assignedToId], references: [id])

  @@index([internalStatus])
  @@index([assignedToId])
}

// ============================================================================
// CUSTOMER NOTES (admin-only internal notes on a customer)
// ============================================================================

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer User @relation("NoteSubject", fields: [customerId], references: [id], onDelete: Cascade)
  author   User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([customerId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String // "PAYMENT_VERIFIED", "ORDER_SHIPPED", etc.
  title     String
  body      String              @db.Text
  channel   NotificationChannel
  metadata  Json? // links, order ids, etc.
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([channel])
}

// ============================================================================
// CONTACT / SUPPORT (from public Contact form)
// ============================================================================

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String   @db.Text
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved])
}

// ============================================================================
// SETTINGS (Phase E.4 Part A)
// ============================================================================

// Admin-editable store settings, DB-backed. Exactly one row: `id` defaults to
// the literal "singleton", so a second insert collides on the primary key.
// These are the runtime source of truth for payment-receiving details, the
// WhatsApp handoff number, and the two COD delivery charges (the delivery-charge
// LOGIC stays in code per ADR-016 — only the two NUMBERS live here). Seeded from
// src/config/payment.ts defaults so behavior is unchanged until an admin edits.
model Settings {
  id                 String   @id @default("singleton")
  bkashNumber        String
  bkashType          String // "personal" | "merchant"
  bkashInstructions  String?
  nagadNumber        String
  nagadType          String
  nagadInstructions  String?
  whatsappNumber     String
  messengerUrl       String? // full m.me/<page> or messenger link; null/empty hides the button
  codInsideDhaka     Int
  codOutsideDhaka    Int
  paymentGeneralNote String?
  updatedAt          DateTime @updatedAt
}

// ============================================================================
// COUPONS (Phase E.5)
// ============================================================================

// A discount coupon. Applied to the order SUBTOTAL only (never delivery, per
// ADR-017). The discount is always recomputed server-side (ADR-005); the code
// is stored UPPERCASE and matched case-insensitively.
model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique // stored UPPERCASE; matched case-insensitively
  description      String?
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2) // percent (e.g. 10.00) or fixed BDT (e.g. 200.00)
  minOrderAmount   Decimal      @default(0) @db.Decimal(10, 2) // min SUBTOTAL to qualify
  totalUsageLimit  Int? // null = unlimited total redemptions
  perCustomerLimit Int? // null = unlimited per customer
  validFrom        DateTime?
  validUntil       DateTime? // expiry
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]
}

// One row per coupon redemption — created atomically inside the order-placement
// transaction (Phase E.5). orderId is unique: at most one redemption per order.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique // one redemption per order
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
  @@index([couponId])
}
